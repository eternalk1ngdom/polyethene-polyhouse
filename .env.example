DB_URL=jdbc:mysql://localhost:3306/polyhouse_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=3s
REDIS_TIMEOUT=5s
# 标准 Base64 编码的 32 字节安全随机密钥；这里只列变量，不填写真实值。
POLYHOUSE_JWT_SECRET=
# 头像持久目录：Spring Boot 不会自动读取本文件，需在运行配置注入。
POLYHOUSE_AVATAR_DIRECTORY=E:/polyhouse-data/avatars
